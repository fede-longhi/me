# Beast Path content authoring (local only)
NEXT_PUBLIC_BEAST_PATH_DEV=true

# Same random secret locally; on Vercel set BEAST_PATH_CONTENT_SECRET for Production/Preview
# Optionally mirror as NEXT_PUBLIC_… so Publish doesn't prompt
BEAST_PATH_CONTENT_SECRET=
NEXT_PUBLIC_BEAST_PATH_CONTENT_SECRET=

# From Vercel Blob store → .env.local
BLOB_READ_WRITE_TOKEN=

# Site admin (Auth.js). Generate AUTH_SECRET with: openssl rand -base64 32
# Hash the password with:
# node --input-type=module -e "import bcrypt from 'bcryptjs'; console.log(await bcrypt.hash('YOUR_PASSWORD', 12))"
AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Org Data Bridge — encrypts Salesforce session cookies (generate a long random string)
SF_SESSION_ENCRYPT_KEY=
